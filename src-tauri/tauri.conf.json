{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapora",
  "version": "1.0.1",
  "identifier": "app.snapora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snapora",
        "width": 1060,
        "height": 700,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$HOME/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Snapora Project — MIT License",
    "shortDescription": "Capture. Edit. Share.",
    "longDescription": "Snapora is a modern Windows screenshot tool with region, window, freeform and monitor capture, a built-in editor, clipboard sharing and a screenshot history.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
